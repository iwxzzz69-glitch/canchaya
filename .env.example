POSTGRES_USER=canchaya
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=canchaya

RABBITMQ_USER=canchaya
RABBITMQ_PASS=cambia_esta_clave

# Mismo secreto en monolito y chat: el chat valida los JWT que emite el monolito
JWT_SECRET=cambia_este_secreto_largo

# Opcional: duración del token de acceso (por defecto 1d)
# JWT_EXPIRES_IN=1d

# Opcional: minutos que se bloquea un horario mientras el jugador paga (por defecto 10)
# BOOKING_HOLD_MINUTES=10

# --- Pagos ---
# Sin CULQI_SECRET_KEY se usa una pasarela SIMULADA (solo desarrollo; no arranca con NODE_ENV=production).
# Llaves de integración en https://integ-panel.culqi.com (Desarrollo > API Keys)
# PAYMENT_PROVIDER=culqi
# CULQI_SECRET_KEY=sk_test_xxxxxxxx
# CULQI_PUBLIC_KEY=pk_test_xxxxxxxx
# CULQI_API_URL=https://api.culqi.com/v2
# Secreto que va en la URL del webhook: /payments/webhooks/culqi/<este valor> (genera uno largo y aleatorio)
# CULQI_WEBHOOK_SECRET=
# Segundos extra que se alarga el bloqueo del horario mientras se cobra (por defecto 180)
# PAYMENT_GRACE_SECONDS=180

# --- Eventos y chat ---
# Cada cuántos ms revisa el monolito la bandeja de salida de eventos (por defecto 1000)
# EVENTS_POLL_MS=1000
# Origen permitido para el chat desde el navegador (por defecto http://localhost:3000)
# CHAT_CORS_ORIGIN=http://localhost:3000
